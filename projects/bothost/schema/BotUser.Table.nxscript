dialect "../../schema/language/Schema.Language.nxscript";

Table BotUser {
    TableName: BOT_USER;
    Fields: [
        Field BARE_JID { Type: "varchar(255)"; },
        Field ENABLED { Type: "smallint"; }
    ];
}
