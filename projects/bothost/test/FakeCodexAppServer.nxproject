dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project FakeCodexAppServer TargetOS[win64] {
    Id: "NXRP.Tools.FakeCodexAppServer";
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/FakeCodexAppServer/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/bothost/test/FakeCodexAppServer.lpr"];
        OutputPath: @FakeCodexAppServer.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/bothost/test",
                @Tools.Native.RTLPath
            ];
        }
    }
}
