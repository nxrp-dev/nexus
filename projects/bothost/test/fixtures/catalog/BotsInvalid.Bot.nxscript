dialect "../../../language/Bot.Language.nxscript";

BotCatalog NexusBots {
    Bots: [
        Bot NexusBot {
            Provider: Codex;
            Model: "gpt-5.6-luna";
            Instructions: "A valid definition in an invalid catalog.";
        },
        Bot Broken {
            Provider: Codex;
            Instructions: "This definition deliberately omits Model.";
        }
    ];
}
