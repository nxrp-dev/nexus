dialect "../../../language/Bot.Language.nxscript";

BotCatalog NexusBots {
    Workspaces: [
        Workspace Nexus {
            Purpose: "Nexus reference source.";
            SourceType: Git;
            Source: "https://github.com/nxrp-dev/nexus.git";
            Ref: main;
            Location: "//nexus-tests/workspaces/nexus";
        },
        Workspace Docs {
            SourceType: Git;
            Source: "https://github.com/nxrp-dev/nexus-docs.git";
            Location: "//nexus-tests/workspaces/docs";
        }
    ];
    Bots: [
        Bot NexusBot {
            Provider: Codex;
            Model: "gpt-5.6-luna";
            Instructions: "Test bot.";
            Workspaces: [@NexusBots.Workspaces.Nexus,
                @NexusBots.Workspaces.Docs];
        },
        Bot OpenAIBot {
            Provider: OpenAI;
            Model: "gpt-5.6-luna";
            Instructions: "Test OpenAI bot.";
            Workspaces: [@NexusBots.Workspaces.Nexus];
        }
    ];
}
