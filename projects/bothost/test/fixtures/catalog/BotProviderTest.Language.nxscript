Language BotProviderTest {
    UnknownDefinitions: Reject;
    Definitions: [
        Definition BotCatalog {
            Root: True;
            UnknownProperties: Reject;
            Properties: [
                Property Bots {
                    Required: True;
                    Value Value {
                        SourceForms: [Array];
                        EffectiveCategories: [Array];
                        Array Array {
                            Minimum: 1;
                            Names: Required;
                            EntrySourceForms: [InlineDefinition];
                            EntryEffectiveCategories: [Definition];
                            DefinitionKinds: [Bot];
                            Mixed: False;
                        }
                    }
                }
            ];
        },
        Definition Bot {
            UnknownProperties: Reject;
            Properties: [
                Property Provider {
                    Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Scalar: Text;
                        AllowedValues: [Codex, Unregistered];
                    }
                },
                Property Model {
                    Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Scalar: Text;
                    }
                },
                Property Instructions {
                    Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Scalar: Text;
                    }
                }
            ];
        }
    ];
}
