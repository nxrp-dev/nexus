dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project NexusBotHostTestModule TargetOS[win64] {
    Id: "NXRP.Tools.NexusBotHostTestModule";
    Requires: [@Projects.NexusRTL, @Projects.FCLProcess, @Projects.NexusScript, @Projects.Mustache, @Projects.NexusTest, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.XMPP, @Projects.Synapse, @Projects.OpenSSL, @Projects.Serialization, @Projects.SQLite];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusBotHostTestModule/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/bothost/test/NexusBotHostTestModule.lpr"];
        OutputPath: @NexusBotHostTestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusBotHostTestModule.OutputRoot];
            UnitPaths: [
                "projects/bothost/test",
                "projects/bothost/src",
                "projects/bothost/src/protocol",
                "projects/forge/src"
            ];
        }
    }
}
