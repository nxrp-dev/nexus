<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="10"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <MainUnit Value="0"/>
      <Title Value="NexusBotHost"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <Units Count="2">
      <Unit0>
        <Filename Value="NexusBotHost.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="src\obNXBotHostRuntime.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="..\..\output\NexusBotHost\$(TargetCPU)-$(TargetOS)\NexusBotHost"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="src;src\protocol;..\..\packages\nxscript\src;..\..\packages\foundation\json\src;..\..\packages\network\json-rpc\src;..\..\NexusLib\core\src;..\..\packages\network\xmpp\src;..\..\packages\network\external\synapse"/>
      <UnitOutputDirectory Value="..\..\output\NexusBotHost\$(TargetCPU)-$(TargetOS)\units"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <UseHeaptrc Value="False"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
