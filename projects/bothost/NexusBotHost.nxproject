dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project NexusBotHost TargetOS[win64] {
    Id: "NXRP.Tools.NexusBotHost";
    Requires: [@Projects.FCLProcess, @Projects.NexusScript, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.XMPP, @Projects.Synapse, @Projects.OpenSSL, @Projects.Serialization, @Projects.SQLite, @Projects.Mustache];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusBotHost/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/bothost/NexusBotHost.lpr"];
        OutputPath: @NexusBotHost.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusBotHost.OutputRoot];
            UnitPaths: [
                "projects/bothost/src",
                "projects/bothost/src/protocol",
                @Tools.Native.RTLPath
            ];
        }
    }
}
