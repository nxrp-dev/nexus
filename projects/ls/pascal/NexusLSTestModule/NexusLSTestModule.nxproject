dialect "../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nxbuild/Projects.nxscript";
module "../../../nxbuild/nxbuild.environment.nxscript";

Project NexusLSTestModule TargetOS[win64] {
    Id: "NXRP.Tools.NexusLSTestModule";
    Requires: [@Projects.NexusRTL, @Projects.NexusTest, @Projects.LSP, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Synapse, @Projects.Serialization, @Projects.SQLite];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusLSTestModule/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/ls/pascal/NexusLSTestModule/NexusLSTestModule.lpr"];
        OutputPath: @NexusLSTestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusLSTestModule.OutputRoot];
            UnitPaths: [
                "projects/ls/pascal/NexusLSTestModule",
                "projects/ls/pascal/src",
                "projects/ls/pascal/src/protocol",
                "projects/ls/pascal/src/service",
                "projects/ls/pascal/src/parser",
                "projects/ls/pascal/src/toolchain",
                "projects/nxbuild/src",
                "C:/lazarus/components/lazutils"
            ];
        }
    }
}
