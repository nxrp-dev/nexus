dialect "../../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nxbuild/Projects.nxscript";
module "../../../../nxbuild/nxbuild.environment.nxscript";

Project nxFastParseBenchmark TargetOS[win64] {
    Id: "NXRP.Tools.nxFastParseBenchmark";
    Requires: [@Projects.NexusRTL];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/nxFastParseBenchmark/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/ls/pascal/src/nx_fast_parse_benchmark/nxFastParseBenchmark.lpr"];
        OutputPath: @nxFastParseBenchmark.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-gw3"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
