dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project nexusls TargetOS[win64] {
    Id: "NXRP.Tools.nexusls";
    Requires: [@Projects.NexusRTL, @Projects.LSP, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Synapse, @Projects.Serialization, @Projects.SQLite];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/nexusls/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/ls/pascal/nexusls.lpr"];
        OutputPath: @nexusls.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@nexusls.OutputRoot];
            UnitPaths: [
                "projects/ls/pascal/src",
                "projects/ls/pascal/src/protocol",
                "projects/ls/pascal/src/service",
                "projects/ls/pascal/src/parser",
                "projects/ls/pascal/src/toolchain",
                "projects/nxbuild/src",
                "C:/lazarus" + "/components/lazutils"
            ];
        }
    }
}
