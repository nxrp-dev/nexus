dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project NexusScriptLS TargetOS[win64] {
    Id: "NXRP.Tools.NexusScriptLS";
    Requires: [@Projects.NexusScript, @Projects.LSP, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Synapse, @Projects.Serialization, @Projects.SQLite, @Projects.Mustache];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusScriptLS/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/ls/nxscript/NexusScriptLS.lpr"];
        OutputPath: @NexusScriptLS.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/ls/nxscript/src/model",
                "projects/ls/nxscript/src/protocol",
                "C:/lazarus" + "/components/lazutils",
                @Tools.Native.RTLPath
            ];
        }
    }
}
