dialect "../../../nxbuild/language/nxbuild.Language.nxscript";

Project NexusScriptLSTests {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "NexusScriptLSTests.lpr";
    OutputRoot: "../../../../output/NexusScriptLS/console-tests/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../../tools/nexus-fpc/compiler/ppcx64.exe";
        LazarusRoot: "C:/lazarus";
    }
    FPCBuildOptions Compiler {
        OutputFile: @NexusScriptLSTests.OutputRoot + "/NexusScriptLSTests.exe";
        RawOptions: ["-gh", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: @NexusScriptLSTests.OutputRoot;
            UnitOutputPath: "../../../../output/NexusScriptLS/console-tests/x86_64-win64/units";
            IncludePaths: ["../../../../output/NexusScriptLS/console-tests/x86_64-win64/units"];
            UnitPaths: [
                ".",
                "../src/model",
                "../src/protocol",
                "../../../../packages/nexus-packages/nxscript/src",
                "../../../../packages/nexus-packages/lsp/src",
                "../../../../packages/nexus-packages/lsp/src/protocol",
                "../../../../packages/nexus-packages/serialization/json/src",
                "../../../../packages/nexus-packages/network/json-rpc/src",
                "../../../../packages/nexus-packages/core/src",
                "../../../../packages/nexus-packages/nxtest/src",
                "../../../../packages/nexus-packages/network/external/synapse",
                @NexusScriptLSTests.NexusFPC.LazarusRoot + "/components/lazutils",
                "../../../../packages/nexus-packages/serialization/src",
                "../../../../packages/nexus-packages/db/sqlite/src/bindings",
                "../../../../packages/nexus-packages-ext/mustache/external/dmustache",
                "../../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
