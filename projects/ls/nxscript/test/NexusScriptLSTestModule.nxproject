dialect "../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nxbuild/Projects.nxscript";
module "../../../nxbuild/nxbuild.environment.nxscript";

Project NexusScriptLSTestModule TargetOS[win64] {
    Id: "NXRP.Tools.NexusScriptLSTestModule";
    Requires: [@Projects.NexusScript, @Projects.LSP, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.NexusTest, @Projects.Synapse, @Projects.Serialization, @Projects.SQLite, @Projects.Mustache];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusScriptLSTestModule/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/ls/nxscript/test/NexusScriptLSTestModule.lpr"];
        OutputPath: @NexusScriptLSTestModule.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusScriptLSTestModule.OutputRoot];
            UnitPaths: [
                "projects/ls/nxscript/test",
                "projects/ls/nxscript/src/model",
                "projects/ls/nxscript/src/protocol",
                "C:/lazarus" + "/components/lazutils",
                @Tools.Native.RTLPath
            ];
        }
    }
}
