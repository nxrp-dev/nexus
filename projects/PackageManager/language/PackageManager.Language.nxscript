dialect "../../../packages/nxscript/language/Language.nxscript";

// Provisional rules for inspecting the three entities, not their final schemas.
Language NexusPackageManager {
    UnknownDefinitions: Reject;
    Definitions: [
        Definition Package {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Id { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Requires {
                    Value Value {
                        EffectiveCategories: [Array];
                        Array Array { EntryEffectiveCategories: [Text]; }
                    }
                }
            ];
        },
        Definition PackageIndex {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
        },
        Definition Project {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
        }
    ];
}
