dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project nxpackage TargetOS[linux, win64] {
    Id: "NXRP.Tools.nxpackage";
    Requires: [@Projects.NexusRTL, @Projects.NXBuild, @Projects.GUI, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.RegExpr];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/nxpackage/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/nxpackage/nxpackage.lpr"];
        OutputPath: @nxpackage.OutputRoot;
        Target Platform TargetOS[linux] { OperatingSystem: "linux"; }
        Target Platform TargetOS[win64] { OperatingSystem: "win64"; ApplicationType: Graphic; }
        Definitions Symbols TargetOS[win64] { Defines: [GDI]; }
        Linking Link TargetOS[win64] { ExternalLinker: Enabled; }
        Linking RuntimeSearch TargetOS[linux] { LinkerOptions: ["-rpath=$ORIGIN"]; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@nxpackage.OutputRoot];
            UnitPaths: [
                "projects/nxpackage/src"
            ];
        }
    }
}
