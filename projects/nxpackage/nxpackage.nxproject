dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project nxpackage TargetOS[win64] {
    Id: "NXRP.Tools.nxpackage";
    Requires: [@Projects.NexusRTL, @Projects.NXBuild, @Projects.GUI, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.RegExpr];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/nxpackage/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxpackage/nxpackage.lpr"];
        OutputPath: @nxpackage.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-dGDI", "-WG", "-Xe"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@nxpackage.OutputRoot];
            UnitPaths: [
                "projects/nxpackage/src"
            ];
        }
    }
}
