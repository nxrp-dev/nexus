dialect "../../language/nxpackage.Language.nxscript";

// Synthetic hash data for editing tests. No actual content has been hashed.
PackageIndex HashExample {
    LocalPackage External {
        Id: "SQLite.SQLite";
        Descriptor: "unavailable/ExternalPackage.nxscript";
        ContentHash Advertised {
            Algorithm: "synthetic-test-algorithm";
            Digest: "synthetic-test-digest";
        }
    }
}
