dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project nxpackageTests TargetOS[win64] {
    Id: "NXRP.Tools.nxpackageTests";
    Requires: [@Projects.NXBuild, @Projects.GUI, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.RegExpr, @Projects.NexusTest];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/nxpackageTests/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxpackage/test/nxpackageTests.lpr"];
        OutputPath: @nxpackageTests.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-dGDI", "-gh", "-gl", "-Xe"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@nxpackageTests.OutputRoot];
            UnitPaths: [
                "projects/nxpackage/test",
                "projects/nxpackage/src",
                @Tools.Native.RTLPath
            ];
        }
    }
}
