dialect "../../../packages/nexus-packages/nxscript/language/Language.nxscript";

// Entity declarations only. Discovery, resolution and execution are not performed.
Language nxpackage {
    UnknownDefinitions: Reject;
    Definitions: [
        Definition Package {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Id { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Version { Value Value { EffectiveCategories: [Text]; } },
                Property Author { Value Value { EffectiveCategories: [Text]; } },
                Property Description { Value Value { EffectiveCategories: [Text]; } },
                Property License { Value Value { EffectiveCategories: [Text]; } },
                Property Requires {
                    Value Value {
                        EffectiveCategories: [Array];
                        Array Array {
                            Names: Optional;
                            EntrySourceForms: [Reference];
                            EntryEffectiveCategories: [Definition];
                            DefinitionKinds: [LocalPackage, ExternalPackage];
                        }
                    }
                }
            ];
        },
        Definition PackageIndex {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Children: [
                Child Packages { Kinds: [LocalPackage, ExternalPackage]; },
                Child Repositories { Kinds: [TrustedRepository]; }
            ];
        },
        Definition RepositoryIndex {
            Root: True;
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Children: [
                Child Packages { Kinds: [LocalPackage, ExternalPackage]; },
                Child Repositories { Kinds: [TrustedRepository]; }
            ];
        },
        Definition LocalPackage {
            Root: False;
            Parents: [PackageIndex, RepositoryIndex];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Id { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Descriptor { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Version { Value Value { EffectiveCategories: [Text]; } },
                Property Description { Value Value { EffectiveCategories: [Text]; } }
            ];
            Children: [Child Hash { Kinds: [ContentHash]; Maximum: 1; }];
        },
        Definition TrustedRepository {
            Root: False;
            Parents: [PackageIndex, RepositoryIndex];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Source { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition ExternalPackage {
            Root: False;
            Parents: [PackageIndex, RepositoryIndex];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Id { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Repository {
                    Required: True;
                    Value Value {
                        SourceForms: [Reference];
                        EffectiveCategories: [Definition];
                        Reference Reference { Targets: [Definition]; DefinitionKinds: [TrustedRepository]; }
                    }
                },
                Property Version { Value Value { EffectiveCategories: [Text]; } },
                Property Description { Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition ContentHash {
            Root: False;
            Parents: [LocalPackage];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Algorithm { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Digest { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
