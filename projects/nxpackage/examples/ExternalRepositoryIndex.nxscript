dialect "../language/nxpackage.Language.nxscript";

// Illustrative nexus-packages-ext catalog, not an inventory of that repository.
// Sharing a host does not automatically establish reciprocal trust.
RepositoryIndex Example {
    LocalPackage SQLite {
        Id: "SQLite.SQLite";
        Descriptor: "ExternalPackage.nxscript";
    }
}
