dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project NexusSetupUITests TargetOS[win64] {
    Id: "NXRP.Tools.NexusSetupUITests";
    Requires: [@Projects.NexusRTL, @Projects.GUI, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.RegExpr, @Projects.NexusTest];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusSetupUITests/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/setup/test/NexusSetupUITests.lpr"];
        OutputPath: @NexusSetupUITests.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-dGDI", "-gh", "-gl", "-Xe"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusSetupUITests.OutputRoot];
            UnitPaths: [
                "projects/setup/test",
                "projects/setup/src"
            ];
        }
    }
}
