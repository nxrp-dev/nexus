dialect "../../language/Setup.Language.nxscript";
Product Tools {
    Id: Tools;
    Name: "Private declarations";
    Version: 1;
    Dependency Host { Ownership: Shared; Requires: [@Tools.Extension]; }
    Dependency Extension { Ownership: Owned; Requires: [@Tools.Host]; }
}
