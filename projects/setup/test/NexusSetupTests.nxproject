dialect "../../../projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../../projects/nxbuild/nxbuild.environment.nxscript";
Project NexusSetupTests {
    Id: "NXRP.Tools.NexusSetupTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.FCLRes, @Projects.NexusScript, @Projects.NexusTest, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.HashLib4Pascal, @Projects.FCLBase, @Projects.Pthreads, @Projects.FCLProcess];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusSetupTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/setup/test/NexusSetupTests.lpr"];
        OutputPath: @NexusSetupTests.OutputRoot;
        RawOptions: ["-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/setup/src"
            ];
        }
    }
}
