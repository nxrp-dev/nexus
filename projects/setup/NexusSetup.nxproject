dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";
Project NexusSetup {
    Id: "NXRP.Tools.NexusSetup";
    Requires: [@Projects.GUI, @Projects.RegExpr, @Projects.FCLImage, @Projects.PasJPEG, @Projects.FCLXML, @Projects.X11, @Projects.Users, @Projects.FCLRes, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache, @Projects.HashLib4Pascal, @Projects.FCLBase, @Projects.Pthreads, @Projects.FCLProcess];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusSetup/" + @Tools.Native.Name;
    FPC Application {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/setup/NexusSetup.lpr"];
        OutputPath: @NexusSetup.OutputRoot;
        RawOptions: ["-gl"];
        Definitions Options TargetOS[win64] { Defines: [GDI]; }
        Target Windows TargetOS[win64] { ApplicationType: Graphic; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                "projects/setup/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src"
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.OS,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src/inc"
            ];
        }
    }
}
