dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project NexusSetupBuilder TargetOS[win64] {
    Id: "NXRP.Tools.NexusSetupBuilder";
    Requires: [@Projects.NexusRTL, @Projects.NexusScript, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.SQLite, @Projects.Core, @Projects.Mustache];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusSetupBuilder/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/setup/NexusSetupBuilder.lpr"];
        OutputPath: @NexusSetupBuilder.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-gl", "-Cr", "-Co", "-Ci"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/setup/src"
            ];
        }
    }
}
