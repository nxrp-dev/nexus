// Small runnable file-only example, not the Nexus distribution inventory.
dialect "../language/Setup.Language.nxscript";
Product FileExample {
    Id: "Nexus.Setup.FileExample";
    Name: "Nexus Setup file example";
    Version: "1.0";
    Location Application { Kind: ApplicationRoot; }
    Feature Documentation {
        Default: True;
        File Readme { Source: "../README.md"; Location: @FileExample.Application; Path: "README.md"; }
        Feature Language {
            Default: True;
            Directory Definitions {
                Source: "../language";
                Location: @FileExample.Application;
                Path: "language";
            }
        }
    }
}

