dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";

Project RTLExtra TargetCPU[x86_64] TargetOS[linux, win64] {
    Id: "NXRP.SDK.RTLExtra";
    RootDirectory: "../../..";
    Description: "Additional platform RTL sources and includes.";
    Publishes Directories {
        Sources: [@Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc", @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform, @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + $TargetOS];
        Headers: [@Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc", @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform, @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + $TargetOS];
    }
}
