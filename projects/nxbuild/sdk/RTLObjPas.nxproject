dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";

Project RTLObjPas TargetCPU[x86_64] TargetOS[linux, win64] {
    Id: "NXRP.SDK.RTLObjPas";
    RootDirectory: "../../..";
    Description: "Object-Pascal RTL sources and includes.";
    Publishes Directories {
        Sources: [@Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/inc", @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform];
        Headers: [@Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/inc", @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform, @Tools.NXPC.SourcePath + "/packages/rtl-objpas/src/" + $TargetCPU];
    }
}
