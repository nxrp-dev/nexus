dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";

Project RTLGenerics TargetCPU[x86_64] TargetOS[linux, win64] {
    Id: "NXRP.SDK.RTLGenerics";
    RootDirectory: "../../..";
    Description: "Generic collection RTL sources and includes.";
    Publishes Directories {
        Sources: [@Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src"];
        Headers: [@Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src", @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src/inc"];
    }
}
