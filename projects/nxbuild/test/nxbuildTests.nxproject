dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";
module Projects "../Projects.nxscript";

Project nxbuildTests {
    Id: "NXRP.nxbuildTests";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NXBuild, @Projects.NexusTest];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/nxbuildTests/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        SourceFiles: ["projects/nxbuild/test/nxbuildTests.lpr"];
        CompilerPath: @Tools.Native.NXPCCompiler;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        OutputPath: @nxbuildTests.OutputRoot;
        RawOptions: ["-gh", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/nxbuild/test"
            ];
        }
    }
}
