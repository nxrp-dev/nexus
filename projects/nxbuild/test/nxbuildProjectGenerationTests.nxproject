dialect "../language/nxbuild.Language.nxscript";
module Projects "../Projects.nxscript";
module "../nxbuild.environment.nxscript";

Project nxbuildProjectGenerationTests {
    Id: "NXRP.Tools.nxbuildProjectGenerationTests";
    Requires: [@Projects.NexusScript, @Projects.NexusTest, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.SQLite, @Projects.Core, @Projects.Mustache];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/nxbuildProjectGenerationTests/" + @Tools.Native.Name;

    FPC Compiler {
        SourceFiles: ["projects/nxbuild/test/nxbuildProjectGenerationTests.lpr"];
        CompilerPath: @Tools.Native.FPCCompiler;
        Target Native { OperatingSystem: "win64"; }
        OutputPath: @nxbuildProjectGenerationTests.OutputRoot;
        RawOptions: ["-gh", "-gl"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            UnitPaths: [
                "projects/nxbuild/test",
                "projects/nxbuild/src",
                "projects/ls/pascal/src/service",
                "projects/ls/pascal/src/protocol",
                "../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
