dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";
module Projects "../Projects.nxscript";
Project PluginTests TargetOS[linux] TargetCPU[x86_64] {
    Id: "NXRP.Tests.Nexus2D.PascalPlugin";
    Requires: [@Projects.NexusTest, @Projects.FCLProcess, @Projects.FCLBase];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/nexus2d-plugin-tests/" + @Tools.Native.Name;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxbuild/test/nxbuildPluginTests.lpr"];
        OutputPath: @PluginTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [@Tools.Native.RTLPath];
        }
    }
}
