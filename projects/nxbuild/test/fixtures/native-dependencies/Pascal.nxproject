dialect "../../../language/nxbuild.Language.nxscript";
module "../../../nxbuild.environment.nxscript";
module NativeProjects "Projects.nxscript";
module Projects "../../../Projects.nxscript";
Project Pascal TargetOS[linux] {
    Id: "Tests.Native.Pascal";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @NativeProjects.Producer, @Projects.NexusTest];
    RootDirectory: "../../../../..";
    OutputRoot: @Tools.OutputRoot + "/generated-dependencies/" + @Tools.Native.Name + "/pascal" + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxbuild/test/fixtures/native-dependencies/GeneratedNativeTests.lpr"];
        OutputPath: @Pascal.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
