                Property GenerateReleaseUnitFiles { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property CompileSystemUnit { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } }
            ];
        },
        Definition Verbosity {
            Root: False;
            Parents: [FPCBuildOptions];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Name { Value Value { Scalar: Text; } },
                Property ShowErrors { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowWarnings { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowNotes { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowHints { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowGeneralInfo { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowLineNumbers { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowEverything { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property WriteFileNamesWithFullPath { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowNothingExceptErrors { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowUnitInfo { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowTriedFiles { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowConditionals { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowDebugInfo { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property RhideGCCCompatibilityMode { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowTimeStamps { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowMessageNumbers { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property ShowInvokedTools { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property WriteParseTreeLog { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property WriteFPCDebugFile { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property WriteOutputToStdErr { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property SuppressedMessages {
                    Value Value {
