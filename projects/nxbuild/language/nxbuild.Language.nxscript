                        Array Array { Names: Forbidden; EntryEffectiveCategories: [Text]; }
                    }
                }
            ];
        },
        Definition Linking {
            Root: False;
            Parents: [FPCBuildOptions];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Name { Value Value { Scalar: Text; } },
                Property DoNotCallAssemblerAndLinker { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property GenerateHostLinkScript { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property GenerateTargetLinkScript { Value Value { Scalar: Text; AllowedValues: [Unset, Enabled, Disabled]; } },
                Property LinkerOptions {
