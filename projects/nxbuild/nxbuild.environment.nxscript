// Installation roots and tool settings shared by native build recipes.
// Resource projects publish the derived source, include and library directories.
Environment Tools TargetCPU[x86_64] {
    OutputRoot: "/media/kcollins/dev/worktree/nexus";
    ToolchainRoot: "/media/kcollins/dev/toolchain/nexus/" + @Tools.Native.Name + "/current";
    SDK WindowsSDK TargetOS[win64] {
        Path: "C:/Program Files (x86)/Windows Kits/10";
        Version: "10.0.19041.0";
        IncludePath: @Tools.WindowsSDK.Path + "/Include/" + @Tools.WindowsSDK.Version;
    }
    SDK MSVC TargetOS[win64] {
        Path: "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133";
        IncludePath: @Tools.MSVC.Path + "/include";
    }
    Platform Native TargetOS[win64] {
        Name: "x86_64-win64";
        OS: "win64";
        ExecutableSuffix: ".exe";
        LLVMCompiler: "C:/Program Files/LLVM/bin/clang.exe";
        LLVMCPPCompiler: "C:/Program Files/LLVM/bin/clang++.exe";
        CompilerUtilitiesPath: "C:/Program Files/LLVM/bin";
        Triple: "x86_64-pc-windows-msvc";
        SystemIncludePaths: [
            "C:/Program Files/LLVM/lib/clang/23/include",
            @Tools.MSVC.IncludePath,
            @Tools.WindowsSDK.IncludePath + "/ucrt",
            @Tools.WindowsSDK.IncludePath + "/shared",
            @Tools.WindowsSDK.IncludePath + "/um"
        ];
        LinkerOptions: ["kernel32.lib", "ucrt.lib", "vcruntime.lib", "msvcrt.lib"];
        PackageSDKPath: "C:/gitdev/tools/nexus-fpc/build/forge-bootstrap/package-sdk";
        PackageSDKIdentity: "E726DB7B2D8B2468510756D0CCB2D7BFA5E6CA7DE6404B8D0F647A08FF6950BC";
        NXPCCompiler: @Tools.ToolchainRoot + "/compiler/bin/" + @Tools.Native.Name + "/nxpc-x86_64.exe";
        RTLPath: @Tools.ToolchainRoot + "/compiler/units/" + @Tools.Native.Name + "/rtl";
        ForgeCompilerPath: @Tools.Native.NXPCCompiler;
        ForgeRTLPath: @Tools.Native.RTLPath;
        PascalPlatform: "win";
        PositionIndependentCode: False;
        ObjectDirectory: "Win64";
    }
    Platform Native TargetOS[linux] {
        Name: "x86_64-linux";
        OS: "linux";
        ExecutableSuffix: "";
        LLVMCompiler: "/usr/bin/clang-18";
        LLVMCPPCompiler: "/usr/bin/clang++-18";
        CompilerUtilitiesPath: "/usr/bin";
        Triple: "x86_64-unknown-linux-gnu";
        SystemIncludePaths: [];
        LinkerOptions: ["-rpath=$ORIGIN"];
        // Set these values from the installed native Linux package SDK.
        PackageSDKPath: "";
        PackageSDKIdentity: "";
        NXPCCompiler: @Tools.ToolchainRoot + "/compiler/bin/" + @Tools.Native.Name + "/nxpc-x86_64";
        RTLPath: @Tools.ToolchainRoot + "/compiler/units/" + @Tools.Native.Name + "/rtl";
        ForgeCompilerPath: @Tools.Native.NXPCCompiler;
        ForgeRTLPath: @Tools.Native.RTLPath;
        PascalPlatform: "unix";
        PositionIndependentCode: True;
        ObjectDirectory: "Linux64";
    }
    Toolchain NXPC TargetOS[win64] {
        SourcePath: "../tools/nexus-fpc";
    }
    Toolchain NXPC TargetOS[linux] {
        SourcePath: "../nexus-fpc";
    }
}
