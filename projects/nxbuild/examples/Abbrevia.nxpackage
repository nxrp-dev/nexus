dialect "../language/nxbuild.Language.nxscript";
module "../nxbuild.environment.nxscript";

// One build sequence; target-specific installation settings come from the module.
Package Abbrevia {
    RootDirectory: "../../..";
    SourceRoot: "packages/nexus-packages-ext/compression/abbrevia";
    OutputRoot: "output/nxbuild-abbrevia/" + @Tools.Native.Name;

    LLVM Native {
        CompilerPath: @Tools.Native.LLVMCompiler;
        BuildKind: Object;
        PositionIndependentCode: @Tools.Native.PositionIndependentCode;
        Target: @Tools.Native.Triple;
        SourceFiles: [
            @Abbrevia.SourceRoot + "/external/abbrevia/thirdparty/lzma/*.c",
            @Abbrevia.SourceRoot + "/external/abbrevia/thirdparty/ppmd/*.c",
            @Abbrevia.SourceRoot + "/external/abbrevia/thirdparty/wavpack/*.c"
        ];
        SystemIncludePaths: @Tools.Native.SystemIncludePaths;
        OutputPath: @Abbrevia.OutputRoot + "/native/" + @Tools.Native.ObjectDirectory;
    }
    LLVM BZip2 {
        CompilerPath: @Abbrevia.Native.CompilerPath;
        BuildKind: SharedLibrary;
        PositionIndependentCode: @Tools.Native.PositionIndependentCode;
        Target: @Abbrevia.Native.Target;
        ConfigFiles: ["projects/nxbuild/examples/libbz2-" + @Tools.Native.OS + ".cfg"];
        SourceFiles: [@Abbrevia.SourceRoot + "/external/abbrevia/thirdparty/bzip2/*.c"];
        SystemIncludePaths: @Abbrevia.Native.SystemIncludePaths;
        LibraryPaths: @Tools.Native.LibraryPaths;
        OutputPath: @Abbrevia.OutputRoot + "/pascal";
    }
    FPC Runtime {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@Abbrevia.SourceRoot + "/Abbrevia.nxpk"];
        OutputPath: @Abbrevia.BZip2.OutputPath;
        PackageSDKIdentity: @Tools.Native.PackageSDKIdentity;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: Delphi; }
        Files Paths {
            UnitPaths: [
                @Tools.Native.PackageSDKPath + "/units",
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/packages/fcl-registry/src",
                @Abbrevia.SourceRoot + "/external/abbrevia/source"
            ];
            IncludePaths: [
                @Abbrevia.SourceRoot + "/external/abbrevia/source",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
            PackagePaths: [@Tools.Native.PackageSDKPath + "/packages"];
            LibraryPaths: @Tools.Native.PackageLibraryPaths;
            // Codec object directives include their platform subdirectory.
            ObjectPaths: [@Abbrevia.Native.OutputPath, @Abbrevia.Native.OutputPath + "/.."];
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
        Linking RuntimeLibraries {
            LinkerOptions: @Tools.Native.LinkerOptions;
        }
    }
}