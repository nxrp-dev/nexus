dialect "../language/nxbuild.Language.nxscript";

Project Hello {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "Hello.lpr";
    OutputRoot: "../../../output/nxbuild-example";

    FPCBuildOptions Compiler {
        Files Paths {
            ExecutableOutputPath: @Hello.OutputRoot;
            UnitOutputPath: @Hello.OutputRoot + "/units";
        }
        Language Pascal { Mode: ObjFPC; }
        CodeGeneration Checks { RangeChecking: Enabled; }
        Debug Symbols { LineInfo: Enabled; }
    }
}
