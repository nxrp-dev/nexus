dialect "../language/nxbuild.Language.nxscript";

Package Mixed {
    OutputRoot: "../../../output/nxbuild-mixed";

    LLVM Native {
        BuildKind: Object;
        SourceFiles: ["native.c", "twice.cpp"];
        OutputPath: @Mixed.OutputRoot + "/native";
    }
    FPC Applications {
        SourceFiles: ["Mixed.lpr", "Hello.lpr"];
        OutputPath: @Mixed.OutputRoot + "/application";
        Files Paths {
            ObjectPaths: [@Mixed.Native.OutputPath];
        }
    }
}
