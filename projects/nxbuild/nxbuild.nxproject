dialect "language/nxbuild.Language.nxscript";
module "nxbuild.environment.nxscript";
module Projects "Projects.nxscript";

Project nxbuild {
    Id: "NXRP.nxbuild";
    Requires: [@Projects.NexusScript, @Projects.Serialization, @Projects.FCLProcess];
    Publishes Directories { Sources: ["projects/nxbuild/src"]; }
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/nxbuild-next/" + @Tools.Native.Name;

    FPC Compiler {
        SourceFiles: ["projects/nxbuild/nxbuild.lpr"];
        CompilerPath: @Tools.Native.FPCCompiler;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        OutputPath: @nxbuild.OutputRoot;
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Syntax Operators { COperators: Enabled; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src"
            ];
            UnitPaths: [
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/rtl/inc",
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src"
            ];
        }
    }
}
