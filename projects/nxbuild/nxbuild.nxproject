dialect "language/nxbuild.Language.nxscript";
module "nxbuild.environment.nxscript";
module Projects "Projects.nxscript";

Project nxbuild {
    Id: "NXRP.nxbuild";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NexusScript, @Projects.Serialization, @Projects.FCLProcess];
    Publishes Directories { Sources: ["projects/nxbuild/src"]; }
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/nxbuild-next/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        SourceFiles: ["projects/nxbuild/nxbuild.lpr"];
        CompilerPath: @Tools.Native.FPCCompiler;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        OutputPath: @nxbuild.OutputRoot;
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Syntax Operators { COperators: Enabled; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
