dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project NexusScript {
    Id: "NXRP.Tools.NexusScript";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.NexusScript, @Projects.SQLite, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Mustache, @Projects.Serialization, @Projects.DelimitedText];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusScript/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxscript/cli/NexusScript.lpr"];
        OutputPath: @NexusScript.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: Delphi; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/nxscript/cli"
            ];
        }
    }
}
