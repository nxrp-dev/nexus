dialect "../../forge/language/Forge.nxscript";
module "../config/CSV.nxscript";

Package LookupSQL {
    Outputs: [Output StateSQL { Path: "generated/state.sql"; }];
    CSV States (CompileCSV) {
        Source: "data/lookup/STATE.csv";
        SourceTemplate: "../templates/SQL.mustache";
        Name: STATE_TBL;
        Output: @LookupSQL.Outputs.StateSQL.Path;
    }
}
