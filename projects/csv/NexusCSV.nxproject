dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project NexusCSV {
    Id: "NXRP.Tools.NexusCSV";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.Serialization, @Projects.DelimitedText, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core, @Projects.Mustache, @Projects.Pthreads, @Projects.FCLBase];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusCSV/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/csv/src/NexusCSV.lpr"];
        OutputPath: @NexusCSV.OutputRoot;
        RawOptions: ["-onxcsv" + @Tools.Native.ExecutableSuffix];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Debug Symbols { LineInfo: Enabled; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/csv/src"
            ];
        }
    }
}
