dialect "../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../nxbuild/Projects.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";

Project NexusProfilerImport TargetOS[linux, win64] {
    Id: "NXRP.Tools.NexusProfilerImport";
    Requires: [@Projects.FCLBase, @Projects.NexusRTL, @Projects.SQLite];
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusProfilerImport/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/profiler/NexusProfilerImport.lpr"];
        OutputPath: @NexusProfilerImport.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        RawOptions: ["-Sh-"];
        Linking RuntimeSearch TargetOS[linux] { LinkerOptions: ["-rpath=$ORIGIN"]; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusProfilerImport.OutputRoot];
            UnitPaths: [
                "projects/profiler/src"
            ];
        }
    }
}
