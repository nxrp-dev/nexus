dialect "../../nxbuild/language/nxbuild.Language.nxscript";

Project NexusProfilerImportTests {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "NexusProfilerImportTests.lpr";
    OutputRoot: "../../../output/NexusProfilerImportTests/x86_64-win64";

    TargetPlatform Native { TargetCPU: "x86_64"; TargetOS: "win64"; }
    Toolchain NexusFPC {
        CompilerPath: "../../../../tools/nexus-fpc/compiler/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @NexusProfilerImportTests.OutputRoot + "/NexusProfilerImportTests.exe";
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            ExecutableOutputPath: @NexusProfilerImportTests.OutputRoot;
            UnitOutputPath: "../../../output/NexusProfilerImportTests/x86_64-win64/units";
            IncludePaths: ["../../../output/NexusProfilerImportTests/x86_64-win64/units"];
            UnitPaths: [
                "../src",
                "../../../packages/nexus-packages/db/sqlite/src",
                "../../../packages/nexus-packages/db/sqlite/src/bindings",
                "../../../../tools/nexus-fpc/rtl/units/x86_64-win64",
                "../../../../tools/nexus-fpc/packages/*/units/x86_64-win64"
            ];
        }
    }
}
