dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../nxbuild/Projects.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project NexusProfilerImportTests TargetOS[win64] {
    Id: "NXRP.Tools.NexusProfilerImportTests";
    Requires: [@Projects.SQLite];
    RootDirectory: "../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusProfilerImportTests/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/profiler/tests/NexusProfilerImportTests.lpr"];
        OutputPath: @NexusProfilerImportTests.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-Sh-"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusProfilerImportTests.OutputRoot];
            UnitPaths: [
                "projects/profiler/src",
                @Tools.Native.RTLPath
            ];
        }
    }
}
