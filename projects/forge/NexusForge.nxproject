dialect "../nxbuild/language/nxbuild.Language.nxscript";

Project NexusForge {
    BuildTool: FPC;
    ProjectKind: Program;
    BuildFile: "cli/NexusForge.lpr";
    OutputRoot: "../../output/NexusForge-next/x86_64-win64";

    Toolchain NexusFPC {
        CompilerPath: "../../../tools/nexus-fpc/build/forge-bootstrap/cycle3/ppcx64.exe";
    }
    FPCBuildOptions Compiler {
        OutputFile: @NexusForge.OutputRoot + "/nxforge.exe";
        Config Options { DisableDefaultConfigFiles: True; }
        Debug Symbols { LineInfo: Enabled; }
        Files Paths {
            ExecutableOutputPath: @NexusForge.OutputRoot;
            UnitOutputPath: @NexusForge.OutputRoot + "/units";
            UnitPaths: [
                "src",
                "../nxpackage/src",
                "../../packages/nexus-packages/nxscript/src",
                "../../packages/nexus-packages/serialization/src",
                "../../packages/nexus-packages/serialization/json/src",
                "../../packages/nexus-packages/network/json-rpc/src",
                "../../packages/nexus-packages/core/src",
                "../../packages/nexus-packages-ext/mustache/external/dmustache",
                "../../packages/nexus-packages/db/sqlite/src/bindings",
                "../../../tools/nexus-fpc/build/forge-bootstrap/cycle3/rtl64",
                "../../../tools/nexus-fpc/packages/rtl-objpas/src/inc",
                "../../../tools/nexus-fpc/packages/rtl-generics/src",
                "../../../tools/nexus-fpc/packages/rtl-extra/src/inc",
                "../../../tools/nexus-fpc/packages/rtl-extra/src/win",
                "../../../tools/nexus-fpc/packages/fcl-base/src",
                "../../../tools/nexus-fpc/packages/fcl-base/src/win",
                "../../packages/nexus-packages/serialization/fcl-json/src",
                "../../packages/nexus-packages/fcl-process/src",
                "../../../tools/nexus-fpc/compiler",
                "../../../tools/nexus-fpc/packages/paszlib/src",
                "../../../tools/nexus-fpc/packages/hash/src",
                "../../../tools/nexus-fpc/packages/fcl-hash/src"
            ];
            IncludePaths: [
                "../../../tools/nexus-fpc/packages/rtl-objpas/src/inc",
                "../../../tools/nexus-fpc/packages/rtl-objpas/src/win",
                "../../../tools/nexus-fpc/packages/rtl-objpas/src/x86_64",
                "../../../tools/nexus-fpc/packages/rtl-extra/src/inc",
                "../../../tools/nexus-fpc/packages/rtl-extra/src/win",
                "../../../tools/nexus-fpc/packages/fcl-base/src",
                "../../../tools/nexus-fpc/packages/fcl-base/src/win",
                "../../../tools/nexus-fpc/packages/fcl-base/src/dummy",
                "../../packages/nexus-packages/fcl-process/src/win"
            ];
        }
    }
}
