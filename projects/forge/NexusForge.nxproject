dialect "../nxbuild/language/nxbuild.Language.nxscript";
module "../nxbuild/nxbuild.environment.nxscript";
Project NexusForge {
    RootDirectory: "../..";
    OutputRoot: @Tools.OutputRoot + "/NexusForge-next/" + @Tools.Native.Name;
    FPC Application {
        CompilerPath: @Tools.Native.ForgeCompilerPath;
        SourceFiles: ["projects/forge/cli/NexusForge.lpr"];
        OutputPath: @NexusForge.OutputRoot;
        RawOptions: ["-onxforge" + @Tools.Native.ExecutableSuffix];
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [@Tools.Native.ForgeRTLPath,
                "projects/forge/src",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Base",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Checksum",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Crypto",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Crypto/Blake2BParams",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Crypto/Blake2SParams",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Hash128",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Hash32",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Hash64",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Interfaces",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Interfaces/IBlake2BParams",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Interfaces/IBlake2SParams",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/KDF",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Misc",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/NullDigest",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Simd/Backend",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Simd/Facade",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Utils",
                "projects/nxpackage/src",
                "projects/nxbuild/src",
                "packages/nexus-packages/nxscript/src",
                "packages/nexus-packages/serialization/src",
                "packages/nexus-packages/serialization/json/src",
                "packages/nexus-packages/network/json-rpc/src",
                "packages/nexus-packages/core/src",
                "packages/nexus-packages-ext/mustache/external/dmustache",
                "packages/nexus-packages/db/sqlite/src/bindings",
                "packages/nexus-packages/serialization/fcl-json/src",
                "packages/nexus-packages/fcl-process/src",
                @Tools.NexusFPC.SourcePath + "/compiler",
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/fcl-base/src",
                "packages/nexus-packages/pthreads/src",
                "packages/nexus-packages/fcl-base/src/" + @Tools.Native.PascalPlatform];
            IncludePaths: [@Tools.NexusFPC.SourcePath + "/rtl/inc",
                "packages/nexus-packages/hashlib4pascal/external/hashlib4pascal/HashLib/src/Simd/Backend",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src/inc",
                "packages/nexus-packages/fcl-base/src",
                "packages/nexus-packages/pthreads/src",
                "packages/nexus-packages/fcl-base/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/fcl-base/src/dummy",
                "packages/nexus-packages/fcl-process/src/" + @Tools.Native.PascalPlatform];
        }
    }
}
