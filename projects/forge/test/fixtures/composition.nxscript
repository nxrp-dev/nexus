dialect "../../../../projects/forge/language/Forge.nxscript";

FPC CompileExample {
    Template: "../../templates/FPC.mustache";
    Source: ["hello world & test.lpr"];
    EntryPoint: "hello world & test.lpr";
    Output: "hello world & test.exe";
}

Git InspectRepository {
    Template: "../../templates/Git.mustache";
    Repository: ".";
}

MSBuild BuildSimulator {
    Template: "../../templates/MSBuild.mustache";
    EntryPoint: "Corona.Simulator.sln";
    Configuration: Release;
    Platform: x64;
}

PowerShell BuildDependencies {
    Template: "../../templates/PowerShell.mustache";
    EntryPoint: "Build-X64Dependencies.ps1";
}
