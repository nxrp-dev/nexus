module "Installation.nxscript";

// Shared FPC configuration; Tiny supplies its own entry point and output.
FPC StandardFPC {
    Template: "../../../../../projects/forge/templates/FPC.mustache";
    Compiler: @Installation.Compiler;
    UnitPaths: [
        @Installation.Units + "/rtl",
        @Installation.Units + "/rtl-objpas"
    ];
    Source: [
        "../../../../../packages/nexus-packages/fcl-base/src/*.pas",
        @Installation.Packages + "/fcl-json/src/*.pas",
        "../../../../../packages/nexus-packages/serialization/fcl-xml/src/*.pas"
    ];
    IncludePaths: ["../../../../../packages/nexus-packages/fcl-base/src"];
}
