dialect "../../../../../projects/forge/language/Forge.nxscript";
module "Shared.nxscript";

FPC Tiny (StandardFPC) {
    Output: "../../../../../output/ForgeSharedFPC/tiny.exe";
    Source: ["src/Tiny.lpr", "src/support/*.pas"];
    EntryPoint: "src/Tiny.lpr";
    UnitOutput: "../../../../../output/ForgeSharedFPC";
    IncludePaths: ["src/include"];
}
