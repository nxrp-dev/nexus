dialect "../../../../../NexusLib/script/dialects/NexusForge/NexusForge.Language.nxscript";
module "Shared.nxscript";

Package Tiny {
    Outputs: [Output Application { Path: "../../../../../output/ForgeSharedFPC/tiny.exe"; }];
    FPC Compile (StandardFPC) {
        Source: ["src/Tiny.lpr", "src/support/*.pas"];
        EntryPoint: "src/Tiny.lpr";
        Output: @Tiny.Outputs.Application.Path;
        UnitOutput: "../../../../../output/ForgeSharedFPC";
        IncludePaths: ["src/include"];
    }
}
