module PackageBuild "PackageBuild.nxscript";
Group LinuxPackageBuild (PackageBuild) {
    FPC Compile (PackageBuild.Compile) {
        Compiler: @Prepare.SDKDirectory + "/bin/ppcx64";
        PositionIndependentCode: True;
        LinkerOptions: ["-rpath", "$ORIGIN", "-z", "origin"];
    }
}
