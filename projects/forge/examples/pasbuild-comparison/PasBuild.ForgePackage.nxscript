dialect "../../language/Forge.nxscript";
module "Shared.nxscript";

// Translation of lib/pasbuild/project.xml. See the comparison report for gaps.
// Forge prepares artifact folders, renders includes, then invokes FPC.
Package PasBuild {
    Version: "1.10.0-SNAPSHOT";
    Author: "Graeme Geldenhuys";
    License: "BSD-3-Clause";
    Targets: [
        Dimension TargetCPU { Required: True; Allowed: [x64]; },
        Dimension TargetOS { Required: True; Allowed: [Windows]; },
        Dimension BuildMode { Required: True; Allowed: [default, debug, release]; }
    ];
    Outputs: [Output Executable { Path: @BuildPaths.Directory + "/pasbuild" + @Platform.ExecutableSuffix; }];
    Render VersionInclude {
        Source: "PasBuild.ForgePackage.nxscript";
        Template: "version.mustache";
        Output: @BuildPaths.Directory + "/version.inc";
    }
    Render BuildDateInclude {
        Source: "PasBuild.ForgePackage.nxscript";
        Template: "build-date.mustache";
        Output: @BuildPaths.Directory + "/build-date.inc";
    }
    FPC Compile (CompileApplication) {
        UnitOutput: @BuildPaths.Directory;
        Source: ["src/main/pascal/*.pas"];
        EntryPoint: "src/main/pascal/PasBuild.pas";
        Output: @PasBuild.Outputs.Executable.Path;
    }
}
