Language ForgeMSBuild {
    Definitions: [
        Definition MSBuild {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Executable { Value Value { EffectiveCategories: [Text]; } },
                Property EntryPoint {
                    Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Reference Reference { Targets: [Property]; }
                    }
                },
                Property Configuration { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Platform { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property BuildTarget { Value Value { EffectiveCategories: [Text]; } },
                Property Properties {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                }
            ];
        }
    ];
}
