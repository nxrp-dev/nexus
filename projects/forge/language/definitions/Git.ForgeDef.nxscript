Language ForgeGit {
    Definitions: [
        Definition Git {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Repository {
                    Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Reference Reference { Targets: [Property]; }
                    }
                }
            ];
        }
    ];
}
