Language ForgeFileOperations {
    Definitions: [
        Definition CreateDirectory {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Path { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition WriteTextFile {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Path { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Text { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition CopyFile {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Source { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Destination { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Overwrite { Value Value { Scalar: Boolean; } },
                Property Recursive { Value Value { Scalar: Boolean; } },
                Property CleanDestination { Value Value { Scalar: Boolean; } },
                Property IncludeMasks {
                    Value Value { EffectiveCategories: [Array]; Array Array { Minimum: 1; EntryEffectiveCategories: [Text]; } }
                },
                Property ExcludeNames { Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition CompareFiles {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Left { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Right { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        },
        Definition DeletePath {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Path { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Recursive { Value Value { Scalar: Boolean; } },
                Property MissingOk { Value Value { Scalar: Boolean; } }
            ];
        },
        Definition Archive {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Operation { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Source { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Destination { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Overwrite { Value Value { Scalar: Boolean; } },
                Property Recursive { Value Value { Scalar: Boolean; } },
                Property ExcludeNames { Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
