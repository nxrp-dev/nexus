Language ForgeCSV {
    Definitions: [
        Definition CSV {
            Root: True;
            Parents: [Group];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Source { Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Reference Reference { Targets: [Property]; }
                    }
                },
                Property SourceTemplate { Required: True;
                    Value Value {
                        EffectiveCategories: [Text];
                        Reference Reference { Targets: [Property]; }
                    }
                },
                Property Output { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Compiler {
                    Value Value {
                        EffectiveCategories: [Text];
                        Reference Reference { Targets: [Property]; }
                    }
                },
                Property Name { Value Value { EffectiveCategories: [Text]; } },
                Property Delimiter { Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
