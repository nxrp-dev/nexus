Language ForgeClang {
    Definitions: [
        Definition Clang {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Executable { Value Value { EffectiveCategories: [Text]; } },
                Property Source {
                    Required: True;
                    Value Value { EffectiveCategories: [Array]; Array Array { Minimum: 1; EntryEffectiveCategories: [Text]; } }
                },
                Property Output { Value Value { EffectiveCategories: [Text]; } },
                Property CompileOnly { Required: True; Value Value { Scalar: Boolean; } },
                Property SourceLanguage { Value Value { EffectiveCategories: [Text]; } },
                Property Target { Value Value { EffectiveCategories: [Text]; } },
                Property Standard { Value Value { EffectiveCategories: [Text]; } },
                Property IncludePaths {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                },
                Property SystemIncludePaths {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                },
                Property OptimizationLevel {
                    Value Value { Scalar: Integer; AllowedValues: [0, 1, 2, 3]; }
                },
                Property DisableStackProtector { Value Value { Scalar: Boolean; } },
                Property Defines {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                },
                Property AssemblerSymbols {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                },
                Property Arguments {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                },
                Property WorkingDirectory { Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
