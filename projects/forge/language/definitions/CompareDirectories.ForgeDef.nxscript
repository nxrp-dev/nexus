Language ForgeCompareDirectories {
    Definitions: [
        Definition CompareDirectories {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Left { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Right { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Recursive { Value Value { Scalar: Boolean; } },
                Property IncludeMasks { Value Value { EffectiveCategories: [Array]; Array Array { Minimum: 1; EntryEffectiveCategories: [Text]; } } }
            ];
        }
    ];
}
