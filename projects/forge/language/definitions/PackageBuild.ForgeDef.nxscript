Language ForgePackageBuild {
    Definitions: [
        Definition PackageBuildPrepare {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property SDKDirectory { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property WorkDirectory { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property PackageDirectories {
                    Value Value { EffectiveCategories: [Array]; Array Array { EntryEffectiveCategories: [Text]; } }
                }
            ];
        },
        Definition PackageBundlePublish {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property WorkDirectory { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property OutputDirectory { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Name { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Kind { Required: True; Value Value { AllowedValues: [Package, Console, GUI]; } }
            ];
        }
    ];
}
