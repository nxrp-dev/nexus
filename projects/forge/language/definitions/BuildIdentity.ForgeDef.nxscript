Language ForgeBuildIdentity {
    Definitions: [
        Definition BuildIdentity {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Repository { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property OutputDirectory { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
