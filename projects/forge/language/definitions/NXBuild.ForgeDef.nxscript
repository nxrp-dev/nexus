Language ForgeNXBuild {
    Definitions: [
        Definition NXBuild {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property EntryPoint { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Action { Value Value { Scalar: Text; AllowedValues: [build, validate, plan]; } },
                Property TargetOS { Value Value { EffectiveCategories: [Text]; } },
                Property TargetCPU { Value Value { EffectiveCategories: [Text]; } },
                Property BuildConfiguration { Value Value { EffectiveCategories: [Text]; } },
                Property Executable { Value Value { EffectiveCategories: [Text]; } },
                Property WorkingDirectory { Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
