Language ForgeMsg2Inc {
    Definitions: [
        Definition Msg2Inc {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Reject;
            Properties: [
                Property Template { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property Executable { Value Value { EffectiveCategories: [Text]; } },
                Property Source { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property OutputPrefix { Required: True; Value Value { EffectiveCategories: [Text]; } },
                Property ConstantName { Required: True; Value Value { EffectiveCategories: [Text]; } }
            ];
        }
    ];
}
