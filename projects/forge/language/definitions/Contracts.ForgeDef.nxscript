module nxpackage "../../../nxpackage/language/nxpackage.Language.nxscript";

// The common contract owns metadata. Forge supplies ordered execution.
Language ForgeContracts {
    Definitions: [
        Definition Package {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Allow;
            Properties: @nxpackage.Definitions.Package.Properties;
        },
        Definition Project {
            Root: True;
            Parents: [Group, Package, Project];
            UnknownProperties: Reject;
            UnknownChildren: Allow;
            Properties: @nxpackage.Definitions.Project.Properties;
        },
        PackageIndex: @nxpackage.Definitions.PackageIndex,
        RepositoryIndex: @nxpackage.Definitions.RepositoryIndex,
        LocalPackage: @nxpackage.Definitions.LocalPackage,
        ExternalPackage: @nxpackage.Definitions.ExternalPackage,
        TrustedRepository: @nxpackage.Definitions.TrustedRepository,
        ContentHash: @nxpackage.Definitions.ContentHash
    ];
}
