// Import and compose this group inside a Package or Project. Supply Prepare's
// absolute SDK/work directories, Compile's EntryPoint, and Publish's Name/Kind/output directory.
Group PackageBuild {
    DeletePath CleanWork { Path: @Prepare.WorkDirectory; Recursive: True; }
    PackageBuildPrepare Prepare {
        SDKDirectory: "";
        WorkDirectory: "";
        PackageDirectories: [];
    }
    NXPC Compile {
        WorkingDirectory: @Prepare.WorkDirectory;
        EntryPoint: "";
        Template: "NXPC.mustache";
        Compiler: @Prepare.SDKDirectory + "/bin/nxpc-x86_64.exe";
        Source: [@EntryPoint];
        ResponseFiles: [@Prepare.WorkDirectory + "/package.cfg"];
        UnitOutput: @Prepare.WorkDirectory;
        ExecutableOutput: @Prepare.WorkDirectory;
        DisableDefaultConfigFiles: True;
        Mode: "objfpc";
    }
    PackageBundlePublish Publish {
        WorkDirectory: @Prepare.WorkDirectory;
    }
}
