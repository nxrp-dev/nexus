module LinuxPackageBuild "LinuxPackageBuild.nxscript";
Group LinuxPackageApplication (LinuxPackageBuild) {
    NXPC Compile (LinuxPackageBuild.Compile) {
        RequiredPackages: [nxrtl];
        LinkerOptions: ["-pie",
            "-z", "nocopyreloc", "-z", "text", "-z", "relro", "-z", "now"];
    }
    PackageBundlePublish Publish (LinuxPackageBuild.Publish) {
        Kind: Console;
    }
}
