dialect "../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nxbuild/Projects.nxscript";
module "../../../nxbuild/nxbuild.environment.nxscript";

Project NexusTestUI TargetOS[win64] {
    Id: "NXRP.Tools.NexusTestUI";
    Requires: [@Projects.GUI, @Projects.JSON, @Projects.FCLJSON, @Projects.Serialization, @Projects.SQLite, @Projects.Mustache, @Projects.RegExpr, @Projects.JSONRPC, @Projects.Core, @Projects.NexusTest, @Projects.NexusScript, @Projects.Lua];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusTestUI/" + @Tools.Native.Name;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxtest/ui/src/NexusTestUI.lpr"];
        OutputPath: @NexusTestUI.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-dGDI", "-WG", "-Xe"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusTestUI.OutputRoot];
            LibraryPaths: [@NexusTestUI.OutputRoot];
            UnitPaths: [
                "projects/nxtest/ui",
                "projects/nxtest/ui/src",
                @Tools.Native.RTLPath
            ];
        }
    }
}
