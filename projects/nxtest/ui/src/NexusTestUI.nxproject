dialect "../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nxbuild/Projects.nxscript";
module "../../../nxbuild/nxbuild.environment.nxscript";

Project NexusTestUI TargetOS[linux, win64] {
    Id: "NXRP.Tools.NexusTestUI";
    Requires: [@Projects.NexusRTL, @Projects.GUI, @Projects.JSON, @Projects.FCLJSON, @Projects.Serialization, @Projects.SQLite, @Projects.Mustache, @Projects.RegExpr, @Projects.JSONRPC, @Projects.Core, @Projects.NexusTest, @Projects.NexusScript, @Projects.Lua];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/NexusTestUI/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Compiler {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["projects/nxtest/ui/src/NexusTestUI.lpr"];
        OutputPath: @NexusTestUI.OutputRoot;
        Target Platform TargetOS[linux] { OperatingSystem: "linux"; }
        Target Platform TargetOS[win64] { OperatingSystem: "win64"; ApplicationType: Graphic; }
        Definitions Symbols TargetOS[win64] { Defines: [GDI]; }
        Linking Link TargetOS[win64] { ExternalLinker: Enabled; }
        Linking RuntimeSearch TargetOS[linux] { LinkerOptions: ["-rpath=$ORIGIN"]; }
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler LLVM TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            IncludePaths: [@NexusTestUI.OutputRoot];
            LibraryPaths: [@NexusTestUI.OutputRoot];
            UnitPaths: [
                "projects/nxtest/ui",
                "projects/nxtest/ui/src"
            ];
        }
    }
}
