dialect "../../../nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../nxbuild/Projects.nxscript";
module "../../../nxbuild/nxbuild.environment.nxscript";

Project nxtest_host TargetOS[win64] {
    Id: "NXRP.Tools.nxtest_host";
    Requires: [@Projects.NexusRTL, @Projects.NexusTest, @Projects.Serialization, @Projects.JSON, @Projects.FCLJSON, @Projects.JSONRPC, @Projects.Core];
    RootDirectory: "../../../..";
    OutputRoot: @Tools.OutputRoot + "/nxtest_host/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Compiler {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: ["projects/nxtest/host/src/nxtest_host.lpr"];
        OutputPath: @nxtest_host.OutputRoot;
        Target Platform { OperatingSystem: "win64"; }
        RawOptions: ["-MObjFPC", "-Scgi"];
        Config Options { DisableDefaultConfigFiles: True; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                "projects/nxtest/host/src"
            ];
        }
    }
}
