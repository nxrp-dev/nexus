dialect "../../nxbuild/language/nxbuild.Language.nxscript";
module "../../nxbuild/nxbuild.environment.nxscript";

Project NexusTestTests {
    RootDirectory: "../../..";
    OutputRoot: "output/nxtest-tests/" + @Tools.Native.Name;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "projects/nxtest/test/NexusTestTests.lpr"
        ];
        OutputPath: @NexusTestTests.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                "projects/nxtest/test",
                "packages/nexus-packages/nxtest/src"
            ];
        }
    }
}
