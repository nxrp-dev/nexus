    { type of numbers in Lua  }

    type
      Tlua_Number = TLUA_NUMBER;
    { type for integer functions  }

      Tlua_Integer = TLUA_INTEGER;
    { unsigned integer type  }

      Tlua_Unsigned = TLUA_UNSIGNED;
    { type for continuation-function contexts  }

      Tlua_KContext = TLUA_KCONTEXT;
    {
    ** Type for C functions registered with Lua
     }

      Tlua_CFunction = function (var L:Tlua_State):Tcint;cdecl;
    {
    ** Type for continuation functions
     }

      Tlua_KFunction = function (var L:Tlua_State; status:Tcint; ctx:Tlua_KContext):Tcint;cdecl;
    {
    ** Type for functions that read/write blocks when loading/dumping Lua chunks
     }
(* Const before type ignored *)

      Tlua_Reader = function (var L:Tlua_State; ud:pointer; var sz:Tsize_t):PTcchar;cdecl;
(* Const before type ignored *)

      Tlua_Writer = function (var L:Tlua_State; p:pointer; sz:Tsize_t; ud:pointer):Tcint;cdecl;
    {
    ** Type for memory-allocation functions
     }

      Tlua_Alloc = function (ud:pointer; ptr:pointer; osize:Tsize_t; nsize:Tsize_t):pointer;cdecl;
    {
    ** Type for warning functions
     }
(* Const before type ignored *)

      Tlua_WarnFunction = procedure (ud:pointer; msg:pTcchar; tocont:Tcint);cdecl;
    {
    ** Type used by the debug API to collect debug information
     }
    {
    ** Functions to be called by the debugger in specific events
     }

      Tlua_Hook = procedure (var L:Tlua_State; var ar:Tlua_Debug);cdecl;
