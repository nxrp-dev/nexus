  Table COMPANY_ADDRESS (TMPL_ADDRESS, TMPL_TRACKED) {
    Fields: [
      Field COMPANY_ID {
        Type: @inForce.COMPANY;
      }
    ];
  }

  Table COMPANY_EMAIL (TMPL_EMAIL, TMPL_TRACKED) {
    Fields: [
      Field COMPANY_ID {
        Type: @inForce.COMPANY;
      }
    ];
  }

  Table COMPANY_INDEX {
    Fields: [
      Field PARENT_COMPANY_ID {
        Type: @inForce.COMPANY;
      },
      Field CHILD_COMPANY_ID {
        Type: @inForce.COMPANY;
      }
    ];
  }

  Table COMPANY_NOTE (TMPL_NOTE, TMPL_TRACKED) {
    Fields: [
      Field COMPANY_ID {
        Type: @inForce.COMPANY;
      }
    ];
  }

  Table COMPANY_PHONE (TMPL_PHONE, TMPL_TRACKED) {
    Fields: [
      Field COMPANY_ID {
        Type: @inForce.COMPANY;
      }
    ];
  }

  Table COUNTY {
    Fields: [
      Field NAME {
        Type: DOM_NAME;
      },
      Field STATE {
        Type: DOM_STATE;
      }
    ];
  }

  Table COUNTRY {
    Fields: [
      Field CODE {
        Type: DOM_CODE;
      },
      Field NAME {
        Type: DOM_NAME;
      }
    ];
  }

  Table EMAIL_TYPE (TMPL_TYPE, TMPL_TRACKED) {}

  Table FILE (TMPL_FILE, TMPL_TRACKED) {
  }

  Table FILE_HISTORY (TMPL_TRACKED) {
    Fields: [
      Field FILE_ID {
        Type: @inForce.FILE;
      },
      Field FILE_ATTACHMENT {
        Type: DOM_FILE_ATTACHMENT;
      },
      Field FILE_VERSION {
        Type: DOM_COUNT;
      },
      Field FILENAME {
        Type: DOM_NAME;
      }
    ];
  }

  Table INVOICE (TMPL_DATED, TMPL_TRACKED) {
    Fields: [
