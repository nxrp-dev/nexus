  }

  Table INVOICE_ITEM {
    Fields: [
      Field INVOICE_ID {
        Type: @inForce.INVOICE;
      }
    ];
  }

  Table INVOICE_LINE {
    Fields: [
      Field INVOICE_ID {
        Type: @inForce.INVOICE;
      },
