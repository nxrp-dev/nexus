        Type: DOM_MONEY;
      },
      Field TOTAL_TAX {
        Type: DOM_MONEY;
      },
      Field TOTAL {
        Type: DOM_MONEY;
      },
      Field NOTES {
        Type: DOM_COMMENT;
      },
      Field LOCATION_ID {
        Type: @inForce.LOCATION;
      }
    ];
  }

  Table INVOICE_FILE {
    Fields: [
      Field INVOICE_ID {
        Type: @inForce.INVOICE;
      },
      Field FILE_ID {
        Type: @inForce.FILE;
      }
