      },
      Field TOTAL_COST {
        Type: DOM_MONEY;
      },
      Field ITEM_TYPE {
        Type: DOM_TYPE;
      },
      Field DISCOUNT_PERCENT {
        Type: DOM_PERCENT;
      },
      Field SORT_ORDER {
        Type: DOM_INTEGER;
      },
      Field NAME {
        Type: DOM_NAME;
      },
      Field LAST_QUANTITY {
        Type: DOM_COUNT;
      }
    ];
  }

  Table INVOICE_PACKAGE {
    Fields: [
      Field INVOICE_ID {
        Type: @inForce.INVOICE;
      }
    ];
  }

  Table INVOICE_SERVICE {
