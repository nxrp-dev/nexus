Schema inForce {

  Setting MODULE_POSTFIX {
    Value: "_TBL";
  }
  Setting MODULE_ID_POSTFIX {
    Value: "_ID";
  }
  Setting GENERATOR_PREFIX {
    Value: "GEN_";
  }
  Setting NEXUS_SCHEMA_PRIMARY_KEY_TYPE {
    Value: "DOM_INDEX";
  }

  Data DATA_ADDRESS_TYPE {
    Name: ADDRESS_TYPE;
    Path: "X:\projects\inForce\Database\DML\address_type.csv";
  }
  //data COUNTY <X:\projects\inForce\Database\DML\county.csv>
  Data DATA_LICENSE_TYPE {
    Name: LICENSE_TYPE;
    Path: "X:\projects\inForce\Database\DML\license_type.csv";
  }
  Data DATA_PHONE_TYPE {
    Name: PHONE_TYPE;
    Path: "X:\projects\inForce\Database\DML\phone_type.csv";
  }
  Data DATA_SERVICE_BILLING_TYPE {
    Name: SERVICE_BILLING_TYPE;
    Path: "X:\projects\inForce\Database\DML\service_billing_type.csv";
  }
  Data DATA_STATE {
    Name: STATE;
    Path: "X:\projects\inForce\Database\DML\state.csv";
  }
  Data DATA_ZIPCODE {
    Name: ZIPCODE;
    Path: "X:\projects\inForce\Database\DML\zipcode.csv";
  }
  Data DATA_PERSON_TYPE {
    Name: PERSON_TYPE;
    Path: "X:\projects\inForce\Database\DML\person_type.csv";
  }
  Data DATA_PERSON {
    Name: PERSON;
    Path: "X:\projects\inForce\Database\DML\1_person.csv";
  }
  Data DATA_LOGIN {
    Name: LOGIN;
    Path: "X:\projects\inForce\Database\DML\2_login.csv";
  }

  Type CoreTypes {
    Fields: [
      Field DOM_CUSTOM_235 {
        Type: "varchar(235)";
      },
      Field DOM_ACCOUNT_NUMBER {
        Type: "varchar(100)";
      },
      Field DOM_ADDRESS {
        Type: "varchar(200)";
      },
      Field DOM_AGE {
        Type: "smallint";
      },
      Field DOM_BOOLEAN {
        Type: "smallint";
      },
      Field DOM_CAPTION {
        Type: "varchar(50)";
      },
      Field DOM_CHAR {
        Type: "char(1)";
      },
      Field DOM_CITY {
        Type: "varchar(100)";
      },
      Field DOM_CODE {
        Type: "varchar(6)";
      },
      Field DOM_COLOR {
        Type: "integer";
      },
      Field DOM_COLUMNS {
        Type: "smallint";
      },
      Field DOM_COMMENT {
        Type: "blob sub_type 1 segment size 100";
      },
      Field DOM_COUNT {
        Type: "integer";
      },
      Field DOM_COUNTY {
        Type: "varchar(100)";
      },
      Field DOM_COUNTRY {
        Type: "varchar(100)";
      },
      Field DOM_CPC {
        Type: "varchar(30)";
      },
      Field DOM_DATE {
        Type: "Date";
      },
      Field DOM_DAY {
        Type: "smallint";
      },
      Field DOM_DESCRIPTION {
        Type: "blob sub_type 1 segment size 100";
      },
      Field DOM_DIGITS {
        Type: "smallint";
      },
      Field DOM_DL_NUMBER {
        Type: "varchar(100)";
      },
      Field DOM_DOMAIN {
        Type: "varchar(100)";
      },
      Field DOM_EMAIL {
        Type: "varchar(200)";
      },
      Field DOM_ENUMERATOR_NAME {
        Type: "varchar(100)";
      },
      Field DOM_FILE_ATTACHMENT {
        Type: "blob sub_type 0 segment size 80";
      },
      Field DOM_FLOAT {
        Type: "float";
      },
      Field DOM_GENDER {
        Type: "varchar(1)";
      },
      Field DOM_HOURS {
        Type: "Numeric(8,2)";
      },
      Field DOM_INCHES {
        Type: "Numeric(4,2)";
      },
      Field DOM_INDEX {
        Type: "integer";
      },
      Field DOM_INTEGER {
        Type: "integer";
      },
      Field DOM_LOCATION {
        Type: "varchar(40)";
      },
      Field DOM_MONEY {
        Type: "Double Precision";
      },
      Field DOM_NAME {
        Type: "varchar(100)";
      },
      Field DOM_NAME_PREFIX {
        Type: "varchar(10)";
      },
      Field DOM_NAME_SUFFIX {
        Type: "varchar(15)";
      },
      Field DOM_PASSWORD {
        Type: "varchar(50)";
      },
      Field DOM_PERCENT {
        Type: "Numeric(4,2)";
      },
      Field DOM_PHONE {
        Type: "varchar(13)";
      },
      Field DOM_PRIMARY_INDEX {
        Type: "integer";
      },
      Field DOM_REPORT_TMPL {
        Type: "blob sub_type 0 segment size 400";
      },
      Field DOM_SHORT_GUID {
        Type: "char(32)";
      },
      Field DOM_SIZE {
        Type: "integer";
      },
      Field DOM_SSN {
        Type: "varchar(13)";
      },
      Field DOM_STATE {
        Type: "char(2)";
      },
      Field DOM_SUFFIX {
        Type: "varchar(15)";
      },
      Field DOM_TAX_ID {
        Type: "varchar(15)";
      },
      Field DOM_TIME {
        Type: "time";
      },
      Field DOM_TIMESTAMP {
        Type: "timestamp";
      },
      Field DOM_TYPE {
        Type: "smallint";
      },
      Field DOM_UPC {
        Type: "varchar(20)";
      },
      Field DOM_URL {
        Type: "varchar(255)";
      },
      Field DOM_USERNAME {
        Type: "varchar(20)";
      },
      Field DOM_YEAR {
        Type: "smallint";
      },
      Field DOM_ZIPCODE {
        Type: "varchar(10)";
      }
    ];
  }

  Attributes ATTR_HISTORY {
    Attribute IS_HISTORY {
      Value: "True";
    }
  }

  Template TMPL_ADDRESS {
    Fields: [
      Field ADDRESS_TYPE_ID {
        Type: @inForce.ADDRESS_TYPE;
      },
      Field ADDRESS_LINE_1 {
        Type: DOM_ADDRESS;
      },
      Field ADDRESS_LINE_2 {
        Type: DOM_ADDRESS;
      },
      Field CITY {
        Type: DOM_CITY;
      },
      Field STATE {
        Type: DOM_STATE;
      },
      Field COUNTY {
        Type: DOM_COUNTY;
      },
      Field COUNTRY {
        Type: DOM_COUNTRY;
      },
      Field ZIPCODE {
        Type: DOM_ZIPCODE;
      }
    ];
  }

  Template TMPL_CONTACT_INFORMATION {
    Fields: [
      Field ADDRESS_LINE_1 {
        Type: DOM_ADDRESS;
      },
      Field ADDRESS_LINE_2 {
        Type: DOM_ADDRESS;
      },
      Field CITY {
        Type: DOM_CITY;
      },
      Field STATE {
        Type: DOM_STATE;
      },
      Field COUNTY {
        Type: DOM_COUNTY;
      },
      Field COUNTRY {
        Type: DOM_COUNTRY;
      },
      Field ZIPCODE {
        Type: DOM_ZIPCODE;
      },
      Field PHONE {
        Type: DOM_PHONE;
      }
    ];
  }

  Template TMPL_DATED {
    Fields: [
      Field EFFECTIVE_DATE {
        Type: DOM_TIMESTAMP;
      },
      Field EXPIRATION_DATE {
        Type: DOM_TIMESTAMP;
      }
    ];
  }

  Template TMPL_DIMENSIONS {
    Fields: [
      Field HEIGHT {
        Type: DOM_SIZE;
      },
      Field WIDTH {
        Type: DOM_SIZE;
      },
      Field DEPTH {
        Type: DOM_SIZE;
      }
    ];
  }

  Template TMPL_DISCOUNT {
    Fields: [
      Field FLAT_COST {
        Type: DOM_MONEY;
      },
      Field PERCENT {
        Type: DOM_PERCENT;
      }
    ];
  }

  Template TMPL_EMAIL {
    Fields: [
      Field EMAIL {
        Type: DOM_EMAIL;
      },
      Field EMAIL_TYPE_ID {
        Type: @inForce.EMAIL_TYPE;
      }
    ];
  }

  Template TMPL_FILE {
    Fields: [
      Field FILE_VERSION {
        Type: DOM_COUNT;
      },
      Field FILENAME {
        Type: DOM_NAME;
      },
      Field FILE_ATTACHMENT {
        Type: DOM_FILE_ATTACHMENT;
      }
    ];
  }


  Template TMPL_NOTE {
    Fields: [
      Field NOTE {
        Type: DOM_COMMENT;
      }
    ];
  }

  Template TMPL_PHONE {
    Fields: [
      Field PHONE {
        Type: DOM_PHONE;
      },
      Field PHONE_TYPE_ID {
        Type: @inForce.PHONE_TYPE;
      }
    ];
  }

  Template TMPL_TRACKED {
    Fields: [
      Field CREATED_BY {
        Type: @inForce.PERSON;
      },
      Field CREATED_DATE {
        Type: DOM_TIMESTAMP;
      },
      Field MODIFIED_BY {
        Type: @inForce.PERSON;
      },
      Field MODIFIED_DATE {
        Type: DOM_TIMESTAMP;
      }
    ];
  }

  Template TMPL_TYPE {
    Fields: [
      Field NAME {
        Type: DOM_NAME;
      },
      Field DESCRIPTION {
        Type: DOM_DESCRIPTION;
      },
      Field SORT_ORDER {
        Type: DOM_COUNT;
      }
    ];
  }

  Table ACTIVITY (TMPL_DATED, TMPL_TRACKED) {
    Fields: [
      Field START_DATE {
        Type: DOM_DATE;
      },
      Field START_TIME {
        Type: DOM_TIME;
      },
      Field ACTIVITY_TYPE_ID {
        Type: @inForce.ACTIVITY_TYPE;
      },
      Field ASSIGNED_PERSON_ID {
        Type: @inForce.PERSON;
      },
      Field END_DATE {
        Type: DOM_DATE;
      },
      Field END_TIME {
        Type: DOM_TIME;
      },
      Field CONTACT_PERSON_ID {
        Type: @inForce.PERSON;
      },
      Field SCHEDULE_ID {
        Type: @inForce.SCHEDULE;
      },
      Field SUMMARY {
        Type: DOM_COMMENT;
      },
      Field LOCATION {
        Type: DOM_DESCRIPTION;
      },
      Field PRIORITY_ID {
        Type: @inForce.PRIORITY_TYPE;
      },
      Field COLOR {
        Type: DOM_COLOR;
      },
      Field DETAIL {
        Type: DOM_COMMENT;
      },
      Field ACTIVITY_STATUS_ID {
        Type: @inForce.ACTIVITY_STATUS;
      }
    ];
  }

  Table ACTIVITY_ACTION (TMPL_DATED, TMPL_TRACKED) {
    Fields: [
      Field ACTIVITY_ID {
        Type: @inForce.ACTIVITY;
      },
      Field PERSON_ID {
        Type: @inForce.PERSON;
      },
      Field NOTES {
        Type: DOM_COMMENT;
      }
    ];
  }

  Table ACTIVITY_STATUS (TMPL_TYPE, TMPL_TRACKED) {
    Fields: [
      Field REQUIRES_ACTION {
        Type: DOM_BOOLEAN;
      }
    ];
  }

  Table ACTIVITY_TYPE (TMPL_TYPE, TMPL_TRACKED) {}

  Table ADDRESS_TYPE (TMPL_TYPE, TMPL_TRACKED) {}

  Table CALL_STATUS_TYPE (TMPL_TYPE, TMPL_TRACKED) {}

  Table CATEGORY (TMPL_TYPE, TMPL_TRACKED) {
    Fields: [
      Field PARENT_ID {
        Type: @inForce.CATEGORY;
      }
    ];
  }

  Table CATEGORY_INDEX {
    Fields: [
      Field PARENT_ID {
        Type: @inForce.CATEGORY;
      },
      Field CHILD_ID {
        Type: @inForce.CATEGORY;
      }
    ];
  }

  Table COMPANY (TMPL_TRACKED) {
    Fields: [
      Field URL {
        Type: DOM_URL;
      },
      Field NAME {
        Type: DOM_NAME;
      },
      Field PRIMARY_CONTACT_ID {
