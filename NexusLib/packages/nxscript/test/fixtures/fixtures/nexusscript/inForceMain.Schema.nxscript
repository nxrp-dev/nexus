  Table PERSON_COUNTY (TMPL_DATED, TMPL_TRACKED) {
    Fields: [
      Field PERSON_ID {
        Type: @inForce.PERSON;
      },
      Field COUNTY_ID {
        Type: @inForce.COUNTY;
      },
      Field STATUS {
