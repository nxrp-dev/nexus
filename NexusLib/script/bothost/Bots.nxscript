dialect "Bot/Bot.Language.nxscript";

BotCatalog NexusBots {
    Workspaces: [
        Workspace Nexus {
            Purpose: "Shared reference copy of the Nexus source tree.";
            SourceType: Git;
            Source: "https://github.com/nxrp-dev/nexus.git";
            Ref: main;
            Location: "/srv/nexus/workspaces/nexus";
        }
    ];
    Bots: [
        Bot NexusBot {
            Provider: Codex;
            Model: "gpt-5.6-luna";
            Instructions: "You are NexusBot. Answer directly and concisely.";
        },
        Bot OpenAIBot {
            Provider: OpenAI;
            Model: "gpt-5.6-luna";
            Instructions: "You are OpenAIBot. Answer directly and concisely.";
            Workspaces: [@NexusBots.Workspaces.Nexus];
        }
    ];
}
