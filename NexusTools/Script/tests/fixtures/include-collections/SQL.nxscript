Schema Store {
    Tables: [
        Table Customer {
            Fields: [Field ID { Type: INTEGER; }, Field Name { Type: "VARCHAR(80)"; }];
            Indexes: [Index CustomerName { Columns: Name; }];
        },
        Table Invoice {
            Fields: [Field ID { Type: INTEGER; }, Field CustomerID { Type: INTEGER; }];
            References: [ForeignKey InvoiceCustomer {
                Column: CustomerID;
                Target: @Store.Tables.Customer;
                TargetColumn: ID;
            }];
        }
    ];
}
