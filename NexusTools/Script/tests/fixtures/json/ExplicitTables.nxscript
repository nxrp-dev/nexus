Schema Demo {
    Template Tracked {
        Fields: [
            Field CREATED { Type: TIMESTAMP; }
        ];
    }

    Tables: [
        Table PERSON (Tracked) {
            Fields: [
                Field NAME { Type: VARCHAR; }
            ];
        },
        Table ADDRESS {
            Fields: [
                Field PERSON_ID { Type: @Demo.Tables.PERSON; }
            ];
        }
    ];
}
