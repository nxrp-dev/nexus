dialect "projects/forge/language/Forge.nxscript";
module "Nexus.BuildTools.nxscript";

// Omit SystemStage for a complete host build. Select one stage to rerun it.
// Debug installs the completed host stage into the local toolchain.
// Release stages host products for the complete release assembly.
Project Nexus HostCPU[x86_64] HostOS[linux, win64] {
    Id: "NXRP.System";
    Outputs: [Host: @BuildTools.HostStage];
    Group Applications SystemStage[Applications] {
        NXBuild BuildApplications {
            Template: @BuildTools.NXBuildTemplate;
            Executable: @BuildTools.BootstrapNXBuild;
            EntryPoint: "Nexus.System.nxproject";
            TargetOS: $HostOS;
            TargetCPU: $HostCPU;
            BuildConfiguration: $BuildConfiguration;
        }
    }
    Group Compiler SystemStage[Compiler] {
        Run BootstrapLinux HostOS[linux] {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript",
                "/targets=Build:Bootstrap,Promote:No,BuildRoot:" + @BuildTools.CompilerRoot +
                ",InstallRoot:" + @BuildTools.CompilerInstall + ",SeedCompiler:" + @HostTools.SeedCompiler +
                ",SeedRTL:" + @HostTools.SeedRTL + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run BootstrapWindows HostOS[win64] {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Bootstrap,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run BuildCompilerTools {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Tools,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run BuildPackageSDK {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:PackageSDK,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
    }
    Group Engine SystemStage[Engine] {
        NXBuild BuildEngine {
            Template: @BuildTools.NXBuildTemplate;
            Executable: @BuildTools.NXBuild;
            EntryPoint: "../nexus-mobile/Nexus2DEngine.nxproject";
            TargetOS: $HostOS;
            TargetCPU: $HostCPU;
            BuildConfiguration: $BuildConfiguration;
        }
    }
    Group Extension SystemStage[Extension] {
        CopyFile StageExtension {
            Source: "projects/nexuscode";
            Destination: @BuildTools.ExtensionStage;
            Recursive: True;
            CleanDestination: True;
            ExcludeNames: "node_modules;out;dist;bin;.git";
        }
        CopyFile ExtensionLicense { Source: "LICENSE"; Destination: @BuildTools.ExtensionStage + "/LICENSE"; }
        CopyFile ExtensionLicenseNotice { Source: "LICENSE-NOTICE.md"; Destination: @BuildTools.ExtensionStage + "/LICENSE-NOTICE.md"; }
        CopyFile ExtensionAttributions { Source: "ATTRIBUTIONS.md"; Destination: @BuildTools.ExtensionStage + "/ATTRIBUTIONS.md"; }
        CopyFile Bundle_nxbuild {
            Source: @Tools.OutputRoot + "/nxbuild-next/" + @Tools.Native.Name + "/" + $BuildConfiguration + "/nxbuild" + @Tools.Native.ExecutableSuffix;
            Destination: @BuildTools.ExtensionStage + "/bin/" + @Tools.Native.Name + "/nxbuild" + @Tools.Native.ExecutableSuffix;
        }
        CopyFile Bundle_nexusls {
            Source: @Tools.OutputRoot + "/nexusls/" + @Tools.Native.Name + "/" + $BuildConfiguration + "/nexusls" + @Tools.Native.ExecutableSuffix;
            Destination: @BuildTools.ExtensionStage + "/bin/" + @Tools.Native.Name + "/nexusls" + @Tools.Native.ExecutableSuffix;
        }
        CopyFile Bundle_NexusScriptLS {
            Source: @Tools.OutputRoot + "/NexusScriptLS/" + @Tools.Native.Name + "/" + $BuildConfiguration + "/NexusScriptLS" + @Tools.Native.ExecutableSuffix;
            Destination: @BuildTools.ExtensionStage + "/bin/" + @Tools.Native.Name + "/nexusscriptls" + @Tools.Native.ExecutableSuffix;
        }
        Npm InstallExtensionDependencies {
            Template: @BuildTools.NpmTemplate;
            Executable: @HostTools.Npm;
            Command: "ci";
            Arguments: ["--no-audit", "--no-fund"];
            WorkingDirectory: @BuildTools.ExtensionStage;
        }
        Npm BuildExtension BuildConfiguration[Debug] {
            Template: @BuildTools.NpmTemplate;
            Executable: @HostTools.Npm;
            Command: "run";
            Arguments: ["esbuild"];
            WorkingDirectory: @BuildTools.ExtensionStage;
        }
        Npm PackageExtension BuildConfiguration[Release] {
            Template: @BuildTools.NpmTemplate;
            Executable: @HostTools.Npm;
            Command: "run";
            Arguments: ["package", "--", "--target", @HostTools.ExtensionTarget, "--out", "nexus-pascal.vsix"];
            WorkingDirectory: @BuildTools.ExtensionStage;
        }
    }
    Group CompilerMatrix SystemStage[Matrix] {
        Run i386_linux {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:i386,TargetOS:linux,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run x86_64_linux {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:x86_64,TargetOS:linux,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_linux {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:linux,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run i386_win32 {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:i386,TargetOS:win32,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run x86_64_win64 {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:x86_64,TargetOS:win64,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_win64 {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:win64,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run x86_64_android {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:x86_64,TargetOS:android,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_android {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:android,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run x86_64_darwin {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:x86_64,TargetOS:darwin,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_darwin {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:darwin,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run x86_64_iphonesim {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:x86_64,TargetOS:iphonesim,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_iphonesim {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:iphonesim,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run aarch64_ios {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Cross,TargetCPU:aarch64,TargetOS:ios,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
        Run AssembleCompilerRelease {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            WorkingDirectory: "../nexus-fpc";
            Arguments: ["/input=NXPC.Forge.nxscript", "/targets=Build:Release,BuildRoot:" + @BuildTools.CompilerRoot + ",NXBuildExecutable:" + @BuildTools.NXBuild];
        }
    }
    Group Stage SystemStage[Stage] {
        Run StageHost {
            Template: @BuildTools.RunTemplate;
            Executable: @BuildTools.Forge;
            Arguments: ["/input=Nexus.Stage.nxscript", "/targets=BuildConfiguration:" + $BuildConfiguration + ",HostOS:" + $HostOS + ",HostCPU:" + $HostCPU];
        }
    }
}
