dialect "projects/forge/language/Forge.nxscript";
module "Nexus.BuildTools.nxscript";

// Run after both native hosts have completed their Release stages.
// Copy and verify every required product before assembly can succeed.
Project NexusRelease BuildConfiguration[Release] {
    Id: "NXRP.System.Release";
    Outputs: [Directory: @Tools.OutputRoot + "/system/release"];
    DeletePath Clean { Path: @Tools.OutputRoot + "/system/release"; Recursive: True; }
    CopyFile Host_x86_64_linux {
        Source: @Tools.OutputRoot + "/system/x86_64-linux/Release/host";
        Destination: @Tools.OutputRoot + "/system/release/hosts/x86_64-linux";
        Recursive: True;
    }
    CompareFiles Required_x86_64_linux_0 {
        Left: @Tools.OutputRoot + "/system/x86_64-linux/Release/host/bin/nxbuild";
        Right: @Tools.OutputRoot + "/system/release/hosts/x86_64-linux/bin/nxbuild";
    }
    CompareFiles Required_x86_64_linux_1 {
