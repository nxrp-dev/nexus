dialect "projects/forge/language/Forge.nxscript";
module "projects/nxbuild/nxbuild.environment.nxscript";

Environment BuildTools {
    NXBuildTemplate: "projects/forge/templates/NXBuild.mustache";
    RunTemplate: "projects/forge/templates/Run.mustache";
    NpmTemplate: "projects/forge/templates/Npm.mustache";
    Root: @Tools.OutputRoot + "/system/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    CompilerRoot: @BuildTools.Root + "/compiler";
    CompilerInstall: @BuildTools.Root + "/compiler-install";
    HostStage: @BuildTools.Root + "/host";
    ToolchainRoot: @Tools.ToolchainRoot;
    EngineRoot: @Tools.OutputRoot + "/nexus2d/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    ExtensionStage: @BuildTools.Root + "/extension";
    BootstrapNXBuild: @BuildTools.ToolchainRoot + "/bin/nxbuild" + @Tools.Native.ExecutableSuffix;
    NXBuild: @Tools.OutputRoot + "/nxbuild-next/" + @Tools.Native.Name + "/" + $BuildConfiguration + "/nxbuild" + @Tools.Native.ExecutableSuffix;
    Forge: @Tools.OutputRoot + "/NexusForge-next/" + @Tools.Native.Name + "/" + $BuildConfiguration + "/nxforge" + @Tools.Native.ExecutableSuffix;
}
Environment HostTools HostOS[linux] {
    Npm: "npm";
    ExtensionTarget: "linux-x64";
    SeedCompiler: "/usr/bin/ppcx64";
    SeedRTL: "/usr/lib/x86_64-linux-gnu/fpc/3.2.2/units/x86_64-linux/rtl";
}
Environment HostTools HostOS[win64] {
    Npm: "npm.cmd";
    ExtensionTarget: "win32-x64";
}
