  Pointer(sqlite3_wal_hook) := GetProcedureAddress(gSQLite3Handle, 'sqlite3_wal_hook');
  Pointer(sqlite3_win32_set_directory) := GetProcedureAddress(gSQLite3Handle, 'sqlite3_win32_set_directory');
  Pointer(sqlite3_win32_set_directory16) := GetProcedureAddress(gSQLite3Handle, 'sqlite3_win32_set_directory16');
  Pointer(sqlite3_win32_set_directory8) := GetProcedureAddress(gSQLite3Handle, 'sqlite3_win32_set_directory8');
  sqlite3_data_directory := PPAnsiChar(GetProcedureAddress(gSQLite3Handle, 'sqlite3_data_directory'));
  sqlite3_temp_directory := PPAnsiChar(GetProcedureAddress(gSQLite3Handle, 'sqlite3_temp_directory'));
  sqlite3_version := PAnsiChar(GetProcedureAddress(gSQLite3Handle, 'sqlite3_version'));
  if not Assigned(sqlite3_libversion_number) or
     not Assigned(sqlite3_open_v2) or not Assigned(sqlite3_close) or
     not Assigned(sqlite3_prepare_v3) or not Assigned(sqlite3_step) or
     not Assigned(sqlite3_finalize) or not Assigned(sqlite3_errmsg) then
  begin
    gSQLite3LoadError := 'SQLite library is missing required core exports.';
    UnloadSQLite3;
    Exit(False);
  end;
  if sqlite3_libversion_number() < SQLITE_VERSION_NUMBER then
  begin
    gSQLite3LoadError := 'SQLite runtime is older than the 3.53.4 binding header.';
    UnloadSQLite3;
    Exit(False);
  end;
  Result := True;
end;

end.
