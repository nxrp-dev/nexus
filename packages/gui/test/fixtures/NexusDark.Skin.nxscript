    WidgetFrame: "#FF54575B";
    PrimaryText: "#FFEFF0F1";
    Selection: "#FF3DAEE9";
    SelectionText: "#FFFFFFFF";
    ScrollBar: "#FF3E4349";
    GridLines: "#FF4A4E52";
    Focus: "#FF3DAEE9";
    ButtonTop: "#FF444A50";
    ButtonBottom: "#FF383E44";
    ButtonHoverTop: "#FF4F5862";
    ButtonHoverBottom: "#FF434B55";
    ButtonPressedTop: "#FF2A3035";
    ButtonPressedBottom: "#FF252B30";
    DisabledText: "#FF72767B";
    MenuSeparator: "#FF4A4E52";
    ButtonHighlight: "#FF505860";
    ButtonBorder: "#FF5E6164";
    ProgressTop: "#FF3DAEE9";
    ProgressBottom: "#FF2A8BC4";
    ProgressHighlight: "#FF5BBEF0";
    ProgressBorder: "#FF1F7AAE";
    ProgressTrack: "#FF3E4349";
    CheckBackground: "#FF232629";
    CheckBorder: "#FF5E6164";
