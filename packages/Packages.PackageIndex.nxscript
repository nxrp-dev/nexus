// Resolve the existing entity dialect through the caller's dialect catalog.
dialect "nxpackage.Language.nxscript";

PackageIndex NexusPackages {
    // Discovery only: repositories are not traversed automatically.
    TrustedRepository NexusOwned {
        Source: "https://github.com/nxrp-dev/nexus-packages.git";
    }
    TrustedRepository NexusExternal {
        Source: "https://github.com/nxrp-dev/nexus-packages-ext.git";
    }

    TrustedRepository NexusApple {
        Source: "https://github.com/nxrp-dev/nexus-packages-apple.git";
    }

    // Explicit local inventory; Descriptor is relative to this index file.
    LocalPackage RTLUnicode {
        Id: "NXRP.RTLUnicode";
        Descriptor: "nexus-packages/rtl-unicode/Package.nxscript";
        Description: "Unicode collation, UTF-8 utilities, graphemes, width and code-page mappings.";
    }
    LocalPackage UniversalInterfaces {
        Id: "NXRP.Apple.UniversalInterfaces";
        Descriptor: "nexus-packages-apple/univint/Package.nxscript";
        Description: "Universal Apple C framework interfaces.";
    }
    LocalPackage CocoaInterfaces {
        Id: "NXRP.Apple.CocoaInterfaces";
        Descriptor: "nexus-packages-apple/cocoaint/Package.nxscript";
        Description: "macOS Cocoa Objective-C interfaces.";
    }
    LocalPackage AppleLocale {
        Id: "NXRP.Apple.AppleLocale";
        Descriptor: "nexus-packages-apple/iosxlocale/Package.nxscript";
        Description: "Apple locale and wide-string support.";
    }
    LocalPackage Core {
        Id: "NXRP.Core";
        Descriptor: "nexus-packages/core/Package.nxscript";
        Description: "Shared class registration and command-line parsing.";
    }
    LocalPackage Binding {
        Id: "NXRP.Binding";
        Descriptor: "nexus-packages/binding/Package.nxscript";
        Description: "Source-independent value binding, navigation and edit coordination.";
    }
    LocalPackage FCLDB {
        Id: "NXRP.Database.FCLDB";
        Descriptor: "nexus-packages/db/fcl-db/Package.nxscript";
        Description: "Datasets, SQL parsing, SQLDB, DBF files, data dictionaries and exports.";
    }
    LocalPackage SQLite {
        Id: "NXRP.SQLite";
        Descriptor: "nexus-packages/db/sqlite/Package.nxscript";
        Description: "SQLite bindings, connections and write-through datasets.";
    }
    LocalPackage OpenSSL {
        Id: "NXRP.Network.OpenSSL";
        Descriptor: "nexus-packages/network/openssl/Package.nxscript";
        Description: "OpenSSL 3 bindings, certificate wrappers and Nexus Synapse TLS adapter.";
    }
    LocalPackage FCLRes {
        Id: "NXRP.FCLRes";
        Descriptor: "nexus-packages/fcl-res/Package.nxscript";
        Description: "Executable resource readers, resource models and file version information.";
    }
    LocalPackage FCLRegistry {
        Id: "NXRP.FCLRegistry";
        Descriptor: "nexus-packages/fcl-registry/Package.nxscript";
        Description: "Native Windows registry access with portable XML registry emulation.";
    }
    LocalPackage FCLProcess {
        Id: "NXRP.FCLProcess";
        Descriptor: "nexus-packages/fcl-process/Package.nxscript";
        Description: "External process execution, pipes, local IPC and Windows service support.";
    }
    LocalPackage X11 {
        Id: "NXRP.Graphics.X11";
        Descriptor: "nexus-packages/graphics/x11/Package.nxscript";
        Description: "Xlib, XKB, input, rendering, font and X11 extension bindings.";
    }
    LocalPackage PasJPEG {
        Id: "NXRP.Graphics.PasJPEG";
        Descriptor: "nexus-packages/graphics/pasjpeg/Package.nxscript";
        Description: "Portable Pascal baseline/progressive JPEG codec and BMP stream conversion.";
    }
    LocalPackage FCLImage {
        Id: "NXRP.Graphics.FCLImage";
        Descriptor: "nexus-packages/graphics/fcl-image/Package.nxscript";
        Description: "Image storage, drawing, codecs, barcodes, QR codes and FreeType adapters.";
    }
    LocalPackage GUI {
        Id: "NXRP.GUI";
        Descriptor: "nexus-packages/gui/Package.nxscript";
        Description: "fpGUI controls, skins, rendering and NexusScript editing.";
    }
    LocalPackage LSP {
        Id: "NXRP.LSP";
        Descriptor: "nexus-packages/lsp/Package.nxscript";
        Description: "Reusable Language Server Protocol messages and transports.";
    }
    LocalPackage Lua {
        Id: "NXRP.Lua";
        Descriptor: "nexus-packages/lua/Package.nxscript";
        Description: "Lua API bindings and the generic Pascal RTTI plugin bridge.";
    }
    LocalPackage Abbrevia {
        Id: "NXRP.Compression.Abbrevia";
        Descriptor: "nexus-packages-ext/compression/abbrevia/Package.nxscript";
        Description: "Archive and compression runtime units (Abbrevia).";
    }
    LocalPackage Mustache {
        Id: "NXRP.Mustache";
        Descriptor: "nexus-packages-ext/mustache/Package.nxscript";
        Description: "Mustache template parsing and rendering (DMustache).";
    }
    LocalPackage RegExpr {
        Id: "NXRP.RegExpr";
        Descriptor: "nexus-packages-ext/regexpr/Package.nxscript";
        Description: "Pure Object Pascal regular expression engine (TRegExpr).";
    }
    LocalPackage JSONRPC {
        Id: "NXRP.Network.JSONRPC";
        Descriptor: "nexus-packages/network/json-rpc/Package.nxscript";
        Description: "Typed JSON-RPC messages, values and command dispatch.";
    }
    LocalPackage Torrent {
        Id: "NXRP.Network.Torrent";
        Descriptor: "nexus-packages/network/torrent/Package.nxscript";
        Description: "BitTorrent metadata, peers, trackers and session support.";
    }
    LocalPackage XMPP {
        Id: "NXRP.Network.XMPP";
        Descriptor: "nexus-packages/network/xmpp/Package.nxscript";
        Description: "XMPP client protocol, negotiation and messaging modules.";
    }
    LocalPackage NexusScript {
        Id: "NXRP.NexusScript";
        Descriptor: "nexus-packages/nxscript/Package.nxscript";
        Description: "NexusScript compilation, validation, editing and emitters.";
    }
    LocalPackage NexusTest {
        Id: "NXRP.NexusTest";
        Descriptor: "nexus-packages/nxtest/Package.nxscript";
        Description: "Test cases, suites, assertions, results and module contracts.";
    }
    LocalPackage Serialization {
        Id: "NXRP.Serialization";
        Descriptor: "nexus-packages/serialization/Package.nxscript";
        Description: "Object persistence and static string lookup support.";
    }
    LocalPackage FCLJSON {
        Id: "NXRP.Serialization.FCLJSON";
        Descriptor: "nexus-packages/serialization/fcl-json/Package.nxscript";
        Description: "Free Pascal JSON values, parsing, writing, configuration and RTTI conversion.";
    }
    LocalPackage FCLXML {
        Id: "NXRP.Serialization.FCLXML";
        Descriptor: "nexus-packages/serialization/fcl-xml/Package.nxscript";
        Description: "XML DOM, readers, writers, XPath, configuration, SAX and HTML support.";
    }
    LocalPackage JSON {
        Id: "NXRP.Serialization.JSON";
        Descriptor: "nexus-packages/serialization/json/Package.nxscript";
        Description: "RTTI-backed typed JSON values and object conversion.";
    }
    LocalPackage DelimitedText {
        Id: "NXRP.Serialization.DelimitedText";
        Descriptor: "nexus-packages/serialization/delimited-text/Package.nxscript";
        Description: "Delimited text parsing and conversion to JSON tabular data.";
    }
    LocalPackage Solar2D {
        Id: "NXRP.Solar2D";
        Descriptor: "nexus-packages/solar2d/Package.nxscript";
        Description: "Solar2D native plugin API and Pascal event bridge.";
    }
    LocalPackage HashLib4Pascal {
        Id: "NXRP.HashLib4Pascal";
        Descriptor: "nexus-packages/hashlib4pascal/Package.nxscript";
        Description: "HashLib4Pascal hashing, checksums, HMAC and KDFs.";
    }
}
